# Supabase Phase 2 connection (publishable key only; never use service-role keys in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Add manually to .env.local; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional voice input. Groq is used only for speech-to-text; keep this server-side.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Free USDA My Market News account key. Server only; never use NEXT_PUBLIC_.
USDA_MARKET_NEWS_API_KEY=
